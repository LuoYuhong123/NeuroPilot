# Template only: copy this file to `.env` for local machine-specific settings.

# Input/output
NEUROPILOT_INPUT_DIR=./input_data
NEUROPILOT_RESULTS_DIR=./tmp_pipeline_metrics/demo_run
NEUROPILOT_SUBFOLDERS=
NEUROPILOT_GPU=0

# LLM advisor
# The command-line flag --llm-mode controls whether the pipeline uses the advisor.
# When --llm-mode is shadow/apply, a non-empty OPENAI_API_KEY is enough to switch
# the advisor backend to live automatically after you copy this template to `.env`.
OPENAI_API_KEY=
LLM_ADVISOR_MODEL=gpt-4.1-mini
LLM_ADVISOR_BASE_URL=https://api.openai.com/v1
LLM_ADVISOR_TIMEOUT_S=20

# Optional downstream / reporting
NEUROPILOT_IS_CELL_DATA=false
# Override this from the CLI with --downstream-env if your downstream env uses another name.
NEUROPILOT_DOWNSTREAM_ENV_NAME=suite2p
NEUROPILOT_DOWNSTREAM_PYTHON=
NEUROPILOT_REPORT_GENERATE_PDF=false
NEUROPILOT_REPORT_TRY_PDF=false
STEP1_PLANE0_DIR=
STEP1_OUT_ROOT=roi_selection_outputs
